# Fresh local demo only; never used to create production accounts.
GC_DEMO_PASSWORD=
# 32+ random characters. Required for production and signed video transfers.
GC_AUTH_SECRET=
GC_ALLOW_RESET=0
# Production uses named Firestore in Mumbai with server Application Default Credentials.
# Leave GC_STORE unset for a disposable local file-backed demo.
GC_STORE=
GC_FIREBASE_PROJECT=gridcast-508011
GC_FIRESTORE_DATABASE=gridcast
# Private Cloud Storage bucket; production video uploads fail closed without it.
GC_MEDIA_BUCKET=
# Browser model files are served from public/models/coco-ssd.

# Optional local override, useful on Apple Silicon if the bundled binary cannot run.
# GC_FFPROBE_PATH=/opt/homebrew/bin/ffprobe
