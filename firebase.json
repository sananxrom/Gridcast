{
  "apphosting": {
    "backendId": "gridcast-backend",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions",
      ".next",
      "data",
      ".env*",
      ".agents",
      ".claude",
      ".firebase",
      "Claude outputs",
      "gridcast-research",
      "AI-LOG.md",
      "tests",
      "playwright-report",
      "test-results",
      "*.tsbuildinfo",
      "apphosting.emulator.yaml"
    ]
  },
  "emulators": {
    "apphosting": {
      "port": 5002,
      "rootDirectory": ".",
      "startCommand": "npm run dev"
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "edition": "enterprise",
    "database": "gridcast",
    "location": "asia-south1"
  }
}
